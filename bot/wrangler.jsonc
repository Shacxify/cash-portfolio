{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bikex-bot",
  "main": "worker.js",
  "compatibility_date": "2025-09-24",
  "triggers": {
    // 17:00 and 18:00 UTC on weekdays. Only the one that is 10am in Los
    // Angeles acts (17:00 in PDT, 18:00 in PST), so the posts stay at 10am
    // Pacific across daylight saving.
    "crons": ["0 17,18 * * 1-5"]
  }
}
